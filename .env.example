# Example only. Put real values in your local .env or the hosting platform's Variables screen.

# Live mode needs DEMO_MODE=false, LIVE_ACTIONS_ENABLED=true and every account value below.
DEMO_MODE=true
LIVE_ACTIONS_ENABLED=false
# Protects the /admin and /health endpoints. At least 32 random characters.
ADMIN_TOKEN=
# SQLite file. Use a persistent volume on the server, and a separate file for demo and live mode.
DATABASE_PATH=data/clara.sqlite
TIMEZONE=Europe/Istanbul

# Shown in patient replies. Live mode refuses values that still contain "Demo".
CLINIC_NAME=Demo Clinic
CLINIC_ADDRESS=Demo address — presentation only
CLINIC_PHONE=Demo phone

# Gmail mailbox Clara reads and sends from (IMAP + SMTP with a Google app password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Reception team address for handoffs and operations alerts. Must differ from GMAIL_ADDRESS.
TEAM_EMAIL=

# Google service account key as raw single-line JSON. Share each calendar with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# 1 = Dr. Ayşe Demir (general practice), 2 = Dr. Mehmet Kaya (dermatology), 3 = Dr. Sara Haddad (pediatrics)
CALENDAR_ID_1=
CALENDAR_ID_2=
CALENDAR_ID_3=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Limits
TIMEOUT_SECONDS=20
POLL_SECONDS=60
BATCH_SIZE=10
RETENTION_DAYS=30
MAX_AI_CALLS_DAILY=100
MAX_BODY_CHARS=12000

IMAP_FOLDER=INBOX
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
